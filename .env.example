# Hotel Amil - PostgreSQL Database Configuration
# Provide your PostgreSQL connection string here:
# Examples:
# Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/amil_hotel"
#
# Cloud PostgreSQL (Neon / Supabase / Render / Railway / AWS RDS):
# DATABASE_URL="postgresql://username:password@ep-cool-cloud.us-east-2.aws.neon.tech/amil_hotel?sslmode=require"
